import threading
import queue
import time

# Shared queue
data_queue = queue.Queue()

# Number of items to produce
NUM_ITEMS = 20

def producer():
    for i in range(NUM_ITEMS):
        item = f"Item–{i}"
        print(f"Producer: Produced {item}")
        data_queue.put(item)
        time.sleep(0.1)  # simulate production time
    data_queue.put(None)  # Sentinel value
    print("Producer: Finished producing")

def consumer():
    while True:
        item = data_queue.get()
        if item is None:
            print("Consumer: Finished consuming")
            break
        print(f"Consumer: Consumed {item}")
        time.sleep(0.15)  # simulate consumption time

# Create threads
producer_thread = threading.Thread(target=producer)
consumer_thread = threading.Thread(target=consumer)

# Start threads
producer_thread.start()
consumer_thread.start()

# Wait for threads to finish
producer_thread.join()
consumer_thread.join()

print("Main thread: All done.")
